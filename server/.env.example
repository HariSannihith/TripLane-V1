# ---------------------------------------------------------------------------
# TripLane API — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/triplane
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/triplane?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/triplane

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API (the frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# Google Places API key (Places API - New must be enabled in Google Cloud).
# If left empty the API falls back to a small built-in destination catalogue so
# the app stays usable in development; responses are marked with source:"fallback".
GOOGLE_PLACES_API_KEY=
